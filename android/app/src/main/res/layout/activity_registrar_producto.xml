<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true"
    android:paddingTop="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar producto"
            android:textColor="#0D47A1"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Complete los datos del producto"
            android:textColor="#607D8B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etCodigo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:hint="Código del producto"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Nombre del producto"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Descripción"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etCantidad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Cantidad inicial"
            android:inputType="number"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etUbicacion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Ubicación (ejemplo: A-01-03)"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etLote"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Número de lote"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etVencimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Fecha de vencimiento (dd/mm/aaaa)"
            android:inputType="date"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etCodigoBarras"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Código de barras"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnEscanearCodigo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#EF6C00"
            android:text="ESCANEAR CÓDIGO"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2E7D32"
            android:text="GUARDAR PRODUCTO"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCancelarRegistro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#455A64"
            android:text="CANCELAR"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="50dp"
    android:paddingRight="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de movimientos"
        android:textColor="#0D47A1"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Entradas, salidas y ajustes de inventario"
        android:textColor="#607D8B"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTodosMovimientos"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:backgroundTint="#455A64"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="TODOS"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnEntradas"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:backgroundTint="#2E7D32"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="ENTRADAS"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnSalidas"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:backgroundTint="#C62828"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="SALIDAS"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnAjustes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:backgroundTint="#7B1FA2"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="AJUSTES"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSinMovimientos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="No existen movimientos registrados"
        android:textColor="#78909C"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMovimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnVolverHistorial"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#455A64"
        android:text="VOLVER AL MENÚ"
        android:textColor="#FFFFFF" />

</LinearLayout>
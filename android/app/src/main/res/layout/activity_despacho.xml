<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true"
    android:paddingTop="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Despacho de productos"
            android:textColor="#0D47A1"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Registra las salidas del almacén"
            android:textColor="#607D8B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etDespachoCodigo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:hint="Código del producto"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnBuscarDespacho"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1565C0"
            android:text="BUSCAR PRODUCTO"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnEscanearDespacho"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#EF6C00"
            android:text="ESCANEAR CÓDIGO"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvProductoDespacho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="Primero busca un producto"
            android:textColor="#455A64"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etNumeroPedido"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:hint="Número de pedido"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etCantidadDespacho"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Cantidad a despachar"
            android:inputType="number"
            android:padding="12dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnConfirmarDespacho"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#C62828"
            android:enabled="false"
            android:text="CONFIRMAR DESPACHO"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCancelarDespacho"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#455A64"
            android:text="VOLVER AL MENÚ"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
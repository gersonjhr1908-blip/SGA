<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true"
    android:paddingTop="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar usuario"
            android:textColor="#0D47A1"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Crea una cuenta para el personal del almacén"
            android:textColor="#607D8B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etUsuarioNombreCompleto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:hint="Nombre completo"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etNuevoNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Nombre de usuario"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etNuevaClave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etConfirmarClave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Confirmar contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Rol del usuario"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerRolUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="El administrador controla usuarios y productos. El operario realiza las tareas del almacén."
            android:textColor="#78909C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnGuardarUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="#2E7D32"
            android:text="GUARDAR USUARIO"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCancelarUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#455A64"
            android:text="CANCELAR"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
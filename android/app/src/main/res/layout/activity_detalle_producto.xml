<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true"
    android:paddingTop="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalle del producto"
            android:textColor="#0D47A1"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Consulta o actualiza la información"
            android:textColor="#607D8B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etDetalleCodigo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:hint="Código"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etDetalleNombre"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Nombre"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Descripción"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etDetalleCantidad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Cantidad"
            android:inputType="number"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etDetalleUbicacion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Ubicación"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etDetalleLote"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Lote"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etDetalleVencimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Fecha de vencimiento"
            android:inputType="date"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etDetalleCodigoBarras"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Código de barras"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnActualizarProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#1565C0"
            android:text="ACTUALIZAR PRODUCTO"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnEliminarProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#C62828"
            android:text="ELIMINAR PRODUCTO"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnVolverProductos"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#455A64"
            android:text="VOLVER"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AuditoriaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UsuariosActivity"
            android:exported="false"
